<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath />
	</parent>

	<groupId>org.springframework.samples</groupId>
	<artifactId>petclinic</artifactId>
	<version>4.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>petclinic</name>
	<description>Spring PetClinic modernizado: monolito modular con API REST</description>

	<modules>
		<module>petclinic-common</module>
		<module>petclinic-owners</module>
		<module>petclinic-visits</module>
		<module>petclinic-vets</module>
		<module>petclinic-app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.2.0</springdoc.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.samples</groupId>
				<artifactId>petclinic-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.samples</groupId>
				<artifactId>petclinic-owners</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.samples</groupId>
				<artifactId>petclinic-visits</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.samples</groupId>
				<artifactId>petclinic-vets</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
